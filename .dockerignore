# Contexto de build de la imagen única (raíz). Excluye todo lo que no se necesita en runtime.
.git
.github
.gitattributes
node_modules
.output
.wrangler
dist
dist-ssr
coverage

# Secretos y configuración local: nunca entran en la imagen.
.env
.env.*
!.env.container.example
**/.env
**/.env.*
!**/.env.example
# Variante visual aprobada (solo flags públicos de build, sin secretos). Debe ir DESPUÉS de .env.*
!.env.forwarders-v2

# Backend: solo el paquete de la aplicación (las pruebas y el venv local no entran).
backend/.venv
backend/venv
backend/tests
backend/.pytest_cache
backend/.ruff_cache
backend/logixtic_api.egg-info
backend/Dockerfile
backend/.dockerignore
**/__pycache__
**/*.pyc

# Documentación, base de datos y scripts de desarrollo: no forman parte del runtime.
docs
db
scripts/*
!scripts/start-render.sh
!scripts/staging-gateway.mjs

# Vídeos sin licencia documentada: nunca en el artefacto (la reproducción además está desactivada por flag).
public/media/cinematic/**/*.mp4

# Miscelánea
*.log
.DS_Store

# CLI de Supabase y migraciones: no forman parte del runtime.
supabase

# Fase 5A: evidencia visual, respaldos y recursos sin distribución verificada (no son parte del runtime).
visual-evidence
**/backup-*
**/*.tgz
.claude
*.log
# Imagen sin referencias en src/ (no se pide desde la Home).
public/img zenox/mano con celular.jpg
# Licencia pendiente y sin uso desde la Home Zenox (solo legacy o escenas no montadas). Procedencia no documentada.
public/media/img/aplicacion web.jpg
public/media/img/contenedores.jpg
public/media/img/digitalizacion.jpg
public/__l5e/assets-v1/a51a4305-6dc6-40e2-9957-e59be2d67461/logixtic-port-hero.webp
public/__l5e/assets-v1/4384cb5f-aeb2-4710-a783-d13a4b2016f3/hero-platform.webp
# Fase 4E: sin referencias desde la Home tras sustituir Services (anillo) y Platform (teléfono, mano).
public/img zenox/anillo.jpg
public/zenox-art
