# Plantilla de variables del contenedor all-in-one (Render). Copiar a .env.container.local (ignorado por Git)
# o cargar como variables privadas en Render. Valores vacíos = configuración segura por defecto.
# NUNCA escribir aquí claves reales.

# --- Proceso y red (los fija el contenedor; no cambiar)
APP_ENV=staging
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
AGENT_API_URL=http://127.0.0.1:8010

# --- Pasarela interna Node -> FastAPI. Obligatorio fuera de development (si está vacío, el agente responde 503).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_HMAC_SECRET=

# --- OpenRouter (solo servidor). Modelos :free para staging de bajo volumen; verificar IDs antes de activar.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_JUDGE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_ENGAGEMENT_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TIMEOUT_SECONDS=12
AGENT_TOTAL_TIMEOUT_SECONDS=20

# --- Modo del agente. AGENT_DRY_RUN=true devuelve solo contenido aprobado (sin llamar a OpenRouter).
AGENT_DRY_RUN=true
AGENT_JUDGE_ENABLED=false
AGENT_ENGAGEMENT_ENABLED=false
AGENT_DAILY_MODEL_CALL_BUDGET=300
AGENT_DAILY_TOKEN_BUDGET=150000
AGENT_CTA_COOLDOWN_MINUTES=30

# --- Límites de frecuencia y tamaño
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_MAX_CHARS=800

# --- Supabase (proyecto dedicado de staging; nunca el tenant operativo)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Captura de prospectos: apagada hasta aprobar el aviso y validar el proyecto real.
LEADS_ENABLED=false
PRIVACY_NOTICE_VERSION=pendiente-aprobacion

# --- CORS (el navegador llama al mismo origen; no se necesitan orígenes adicionales)
CORS_ALLOW_ORIGINS=http://localhost:10000
