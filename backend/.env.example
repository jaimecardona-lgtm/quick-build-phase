# Plantilla de configuración del backend. Copiar a .env (ignorado por Git) o definir como
# variables/secretos del host. NUNCA escribir credenciales reales en este archivo.
# Valores de ejemplo ficticios: cualquier valor "EJEMPLO" no funciona y debe reemplazarse.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# --- OpenRouter (solo servidor). La clave nunca va en el repo ni en VITE_*.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Roles de modelo (staging, gratuitos). IDs verificables en OpenRouter antes de activar.
OPENROUTER_PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_JUDGE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_ENGAGEMENT_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1024
# Timeout por llamada y presupuesto total (primary + fallback). El SSR espera 12 s.
OPENROUTER_TIMEOUT_SECONDS=12
AGENT_TOTAL_TIMEOUT_SECONDS=20

# --- Agente
AGENT_DRY_RUN=true
# Judge y Engagement están apagados hasta validarlos en staging.
AGENT_JUDGE_ENABLED=false
AGENT_ENGAGEMENT_ENABLED=false
AGENT_DAILY_MODEL_CALL_BUDGET=300
AGENT_DAILY_TOKEN_BUDGET=150000
AGENT_CTA_COOLDOWN_MINUTES=30

# --- Pasarela SSR -> FastAPI (secreto compartido, solo servidor). Obligatorio fuera de development.
INTERNAL_HMAC_SECRET=EJEMPLO_NO_REAL_reemplazar_por_secreto_generado
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_MAX_CHARS=800

# --- Supabase (proyecto DEDICADO de staging; nunca el tenant ni un proyecto compartido)
SUPABASE_URL=https://EJEMPLO-proyecto.supabase.co
# Clave secreta nueva (sb_secret_*). Solo este servicio la lee. Nunca en el navegador.
SUPABASE_SECRET_KEY=sb_secret_EJEMPLO_NO_REAL
# Captura de prospectos: apagada por defecto.
LEADS_ENABLED=false
# Debe coincidir con la versión del aviso de privacidad mostrada y aceptada en el formulario.
PRIVACY_NOTICE_VERSION=pendiente-aprobacion
