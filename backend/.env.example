# Copia este archivo a .env para desarrollo local. NO versionar .env.
# Sin claves reales: el backend arranca y responde /api/v1/health sin OpenRouter.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_MAX_TOKENS=700
OPENROUTER_TIMEOUT_SECONDS=30
AGENT_DRY_RUN=true
# Variables de Lovable Cloud/Auth se definen posteriormente, tras confirmar entorno

# Agente público (V7). Secreto compartido con la pasarela; dejar vacío solo en desarrollo local.
INTERNAL_HMAC_SECRET=
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_MAX_CHARS=800
# Lovable Cloud Auth y base de datos: se definen cuando el proyecto esté provisionado (ver docs/audit).
